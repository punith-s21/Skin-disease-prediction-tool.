rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Validation Helpers
    function isValidAnalysis(data) {
      return data.keys().hasAll(['condition', 'probability', 'recommendation', 'severity']) &&
             data.condition is string && data.condition.size() <= 300 &&
             data.probability is number &&
             data.recommendation is string && data.recommendation.size() <= 4000 &&
             data.severity in ['Low', 'Moderate', 'High', 'Critical'];
    }

    function isValidHistoryItem(data) {
      return data.keys().hasAll(['id', 'image', 'analysis', 'timestamp', 'skinTone']) &&
             isValidId(data.id) &&
             data.image is string &&
             isValidAnalysis(data.analysis) &&
             data.timestamp is string &&
             data.skinTone is number;
    }

    function isValidCommunityAlert(data) {
      return data.keys().hasAll(['id', 'condition', 'location', 'severity', 'timestamp']) &&
             isValidId(data.id) &&
             data.condition is string && data.condition.size() <= 300 &&
             data.location is string && data.location.size() <= 300 &&
             data.severity in ['Low', 'Moderate', 'High', 'Critical'] &&
             data.timestamp is string;
    }

    function isValidPredictionLog(data) {
      return data.keys().hasAll(['id', 'userId', 'condition', 'probability', 'severity', 'timestamp']) &&
             isValidId(data.id) &&
             data.userId is string &&
             data.condition is string && data.condition.size() <= 300 &&
             data.probability is number &&
             data.severity is string &&
             data.timestamp is string;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'registeredAt']) &&
             isValidId(data.id) &&
             data.email is string &&
             data.registeredAt is string;
    }

    // Test connection check
    match /test/{testId} {
      allow read, write: if true;
    }

    // Collection: History
    match /users/{userId}/history/{historyId} {
      allow list: if true;
      allow get: if true;
      allow create: if isValidId(historyId) && isValidHistoryItem(incoming());
      allow delete: if true;
      allow update: if false;
    }

    // Collection: Alerts
    match /alerts/{alertId} {
      allow list: if true;
      allow get: if true;
      allow create: if isValidId(alertId) && isValidCommunityAlert(incoming());
      allow delete: if true;
      allow update: if false;
    }

    // Collection: Predictions (for system usage analytics)
    match /predictions/{predictionId} {
      allow list: if true;
      allow get: if true;
      allow create: if isValidId(predictionId) && isValidPredictionLog(incoming());
      allow delete: if true;
      allow update: if false;
    }

    // Collection: User Profiles (for admin user tracking)
    match /user_profiles/{userId} {
      allow list: if true;
      allow get: if true;
      allow create, update: if isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if true;
    }
  }
}

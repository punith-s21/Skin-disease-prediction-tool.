{
  "entities": {
    "Analysis": {
      "title": "Analysis",
      "description": "The result of a skin condition analysis.",
      "type": "object",
      "properties": {
        "condition": { "type": "string" },
        "probability": { "type": "number" },
        "recommendation": { "type": "string" },
        "severity": { "type": "string", "enum": ["Low", "Moderate", "High", "Critical"] },
        "localization": { "type": "string" }
      },
      "required": ["condition", "probability", "recommendation", "severity"]
    },
    "HistoryItem": {
      "title": "HistoryItem",
      "description": "A record of a skin analysis and the source image.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "image": { "type": "string", "description": "Base64 encoded image or URL" },
        "analysis": { "type": "object", "$ref": "Analysis" },
        "timestamp": { "type": "string", "format": "date-time" },
        "voiceDescription": { "type": "string" },
        "skinTone": { "type": "integer" },
        "userId": { "type": "string" }
      },
      "required": ["id", "image", "analysis", "timestamp", "skinTone", "userId"]
    },
    "CommunityAlert": {
      "title": "CommunityAlert",
      "description": "An alert reported to the community regarding a skin condition outbreak.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "condition": { "type": "string" },
        "location": { "type": "string" },
        "severity": { "type": "string", "enum": ["Low", "Moderate", "High", "Critical"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "condition", "location", "severity", "timestamp"]
    },
    "PredictionLog": {
      "title": "PredictionLog",
      "description": "A log entry recording an AI inference prediction event for system usage analytics.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "condition": { "type": "string" },
        "probability": { "type": "number" },
        "severity": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "skinTone": { "type": "integer" }
      },
      "required": ["id", "userId", "condition", "probability", "severity", "timestamp"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User registration and account details for admin management.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "registeredAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "predictionsCount": { "type": "integer" }
      },
      "required": ["id", "email", "registeredAt"]
    }
  },
  "firestore": {
    "users/{userId}/history/{historyId}": {
      "schema": "HistoryItem",
      "description": "User specific skin analysis history."
    },
    "alerts/{alertId}": {
      "schema": "CommunityAlert",
      "description": "Public community alerts for disease surveillance."
    },
    "predictions/{predictionId}": {
      "schema": "PredictionLog",
      "description": "System-wide prediction logs for application usage analytics."
    },
    "user_profiles/{userId}": {
      "schema": "UserProfile",
      "description": "Registered user accounts for admin user management."
    }
  }
}
